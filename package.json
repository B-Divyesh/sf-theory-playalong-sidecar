{
  "name": "theory-playalong-sidecar",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts *.config.ts",
    "copycheck": "node scripts/check-copy-audit.mjs",
    "build": "npm run typecheck && vite build && node scripts/stamp-service-worker.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run build && npm run copycheck && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.6"
  }
}
